<Application x:Class="DocPilot.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="AccentBrush" Color="#1F3A5F" />
        <SolidColorBrush x:Key="WindowBackground" Color="#F5F6F8" />
        <SolidColorBrush x:Key="UserBubble" Color="#1F3A5F" />
        <SolidColorBrush x:Key="AssistantBubble" Color="White" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DDE3" />
        <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
        <SolidColorBrush x:Key="ErrorBackground" Color="#FDECEC" />
        <SolidColorBrush x:Key="ErrorText" Color="#B42318" />

        <!-- glavno dugme; sopstveni template da bi onemoguceno stanje bilo jasno vidljivo -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2C5282" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#C9D1DC" />
                                <Setter Property="Foreground" Value="#F5F6F8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
