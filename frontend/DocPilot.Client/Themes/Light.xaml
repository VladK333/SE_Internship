<!-- Svetla tema; Dark.xaml ima iste ključeve. Boje odgovora u WebView2 su u Assets/docpilot.css. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#1F3A5F" />
    <SolidColorBrush x:Key="WindowBackground" Color="#F5F6F8" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="White" />
    <SolidColorBrush x:Key="MainText" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
    <SolidColorBrush x:Key="LinkText" Color="#1F5FAD" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DDE3" />
    <SolidColorBrush x:Key="UserBubble" Color="#1F3A5F" />
    <SolidColorBrush x:Key="UserBubbleText" Color="White" />
    <SolidColorBrush x:Key="AssistantBubble" Color="White" />
    <SolidColorBrush x:Key="ErrorBackground" Color="#FDECEC" />
    <SolidColorBrush x:Key="ErrorText" Color="#B42318" />
    <SolidColorBrush x:Key="BusyBackground" Color="#EEF2F7" />
    <SolidColorBrush x:Key="HoverBackground" Color="#EEF2F7" />
    <SolidColorBrush x:Key="SelectedBackground" Color="#E3EAF3" />
    <SolidColorBrush x:Key="PrimaryButton" Color="#1F3A5F" />
    <SolidColorBrush x:Key="PrimaryButtonHover" Color="#2C5282" />
    <SolidColorBrush x:Key="PrimaryButtonDisabled" Color="#C9D1DC" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledText" Color="#F5F6F8" />
    <SolidColorBrush x:Key="ChipBackground" Color="#EEF2F7" />
    <!-- logo i avatar asistenta -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#1F3A5F" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
