<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- adresa DocPilot servera; 127.0.0.1 umesto localhost jer Windows prvo proba IPv6 i gubi ~2 s -->
    <add key="ApiBaseUrl" value="http://127.0.0.1:8000/" />
    <!-- malo duze od LLM_TIMEOUT na serveru (300 s), da server prvi javi da model kasni -->
    <add key="ApiTimeoutSeconds" value="330" />
    <!-- true: odgovor se prikazuje dok ga model piše (POST /chat/stream); false: čeka se ceo odgovor (POST /chat) -->
    <add key="UseStreaming" value="true" />
  </appSettings>
</configuration>
