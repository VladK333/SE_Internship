<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DocPilot.Client</RootNamespace>
    <AssemblyName>DocPilot</AssemblyName>
    <!-- WebView2Loader.dll je nativna x64 biblioteka -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- ikonica .exe fajla i taskbar-a (avion na plavom prelivu, kao logo u aplikaciji) -->
    <ApplicationIcon>docpilot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- izabrano u istrazivanju: docs/research/Markdown_biblioteke.pdf -->
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- CSS, JS i highlight.js za prikaz odgovora; WebView2 ih vidi kao https://docpilot.assets/ -->
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- ikonica prozora (Window.Icon) -->
    <Resource Include="docpilot.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
